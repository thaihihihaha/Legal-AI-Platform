# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Environment variables (chứa secrets — KHÔNG commit)
server/.env
client/.env
client/.env.production
.env
.env.production

# Build output
client/dist/
client/build/

# File uploads — lưu trên server, KHÔNG commit vào git
# Khi git pull, các file upload cũ vẫn còn trên disk
server/uploads/**
!server/uploads/.gitkeep
!server/uploads/contracts/.gitkeep
!server/uploads/documents/.gitkeep
!server/uploads/templates/.gitkeep

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# Prisma generated
server/node_modules/.prisma/

# Thông tin đăng nhập git (chứa access token còn sống — KHÔNG commit)
# Kho này công khai trên GitHub: token lọt vào một lần commit là lộ vĩnh viễn,
# xoá ở lần commit sau KHÔNG gỡ được vì nó vẫn nằm trong lịch sử.
.git-credentials
.git-credentials/
~/
*.token
*.pat
