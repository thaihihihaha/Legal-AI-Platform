// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "rhel-openssl-1.1.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

enum PlanType {
  trial
  starter
  pro
  enterprise
}

enum UserRole {
  owner
  admin
  member
  viewer
}

model Company {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String    @unique
  plan           PlanType  @default(trial)
  monthly_quota  Int       @default(50)
  used_quota     Int       @default(0)
  quota_reset_at DateTime? @default(dbgenerated("(date_trunc('month', now()) + interval '1 month')")) @db.Timestamptz()
  settings       Json?     @default("{}")
  industry       String?
  employee_count Int?
  tax_code       String?
  created_at     DateTime? @default(now()) @db.Timestamptz()
  updated_at     DateTime? @default(now()) @db.Timestamptz()

  users         User[]
  api_keys      ApiKey[]
  contracts     Contract[]
  documents     Document[]
  chat_sessions ChatSession[]
  messages      Message[]
  categories    Category[]
  tags          Tag[]
  audit_logs    AuditLog[]
  drafts        DraftGenerated[]
  templates     Template[]
  clauses       Clause[] @relation("Clauses")
  integration_configs IntegrationConfig[] @relation("IntegrationConfigs")
  team_metrics  TeamMetric[]       @relation("TeamMetrics")
  analytics     Analytic[]         @relation("Analytics")
  webhooks      Webhook[] @relation("Webhooks")

  @@map("companies")
}

model ApiKey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id   String    @db.Uuid
  name         String
  key_hash     String
  key_prefix   String
  permissions  String[]  @default(["read", "ask", "review"])
  rate_limit   Int       @default(60)
  is_active    Boolean   @default(true)
  last_used_at DateTime? @db.Timestamptz()
  expires_at   DateTime? @db.Timestamptz()
  created_at   DateTime? @default(now()) @db.Timestamptz()

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([key_prefix])
  @@map("api_keys")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id    String?   @db.Uuid
  role          UserRole  @default(member)
  full_name     String?
  email         String?   @unique
  auth_id       String?   @unique @db.Uuid
  password_hash String?
  avatar_url    String?
  phone_number  String?   @db.VarChar(20)
  is_active     Boolean   @default(true)
  is_super_admin Boolean  @default(false)
  preferences   Json?     @default("{}")
  user_settings Json?     @default("{}")
  totp_secret   String?   @db.VarChar(64)
  totp_enabled  Boolean   @default(false)
  last_login_at DateTime? @db.Timestamptz()
  created_at    DateTime? @default(now()) @db.Timestamptz()
  updated_at    DateTime? @default(now()) @db.Timestamptz()

  company         Company?       @relation(fields: [company_id], references: [id], onDelete: SetNull)
  contracts       Contract[]     @relation("ContractsUploadedBy")
  documents       Document[]     @relation("DocumentsUploadedBy")
  chat_sessions   ChatSession[]  @relation("ChatSessionsByUser")
  audit_logs      AuditLog[]     @relation("AuditLogByActor")
  invitations_created InvitationToken[] @relation("InvitationCreateBy")
  refresh_tokens  RefreshToken[] @relation("RefreshTokens")
  drafts_created  DraftGenerated[] @relation("DraftCreatedBy")
  drafts_signed   DraftGenerated[] @relation("DraftSignedBy")
  draft_versions_changed DraftVersion[] @relation("DraftVersionChangedBy")
  
  // PHASE 3 Relations
  review_sessions_initiated ReviewSession[] @relation("ReviewSessionInitiatedBy")
  review_assignments ReviewAssignment[] @relation("ReviewAssignments")
  review_comments ReviewComment[] @relation("ReviewComments")
  review_comments_resolved ReviewComment[] @relation("ReviewCommentResolvedBy")
  draft_access DraftAccess[] @relation("DraftAccess")
  draft_access_granted DraftAccess[] @relation("DraftAccessGrantedBy")
  draft_collaborators DraftCollaborator[] @relation("DraftCollaborators")
  activity_logs ActivityLog[] @relation("ActivityLogs")
  notifications Notification[] @relation("Notifications")
  notifications_about Notification[] @relation("NotificationsAboutUser")
  notification_preferences NotificationPreference[] @relation("NotificationPreferences")
  draft_sharing_by DraftSharing[] @relation("DraftSharingBy")
  draft_sharing_with DraftSharing[] @relation("DraftSharingWith")
  draft_sharing_revoked DraftSharing[] @relation("DraftSharingRevokedBy")
  mentions Mention[] @relation("Mentions")
  audit_trails AuditTrail[] @relation("AuditTrails")
  signatures DigitalSignature[] @relation("DigitalSignatures")
  legal_holds_created LegalHold[] @relation("LegalHoldsCreated")
  legal_holds_lifted LegalHold[] @relation("LegalHoldsLifted")
  compliance_checks ComplianceCheck[] @relation("ComplianceChecks")
  template_versions TemplateVersion[] @relation("TemplateVersions")
  templates_created Template[] @relation("TemplatesCreatedBy")
  export_history ExportHistory[] @relation("ExportHistory")
  approval_stages ApprovalStage[] @relation("ApprovalStages")
  delegated_approvals ApprovalStage[] @relation("DelegatedApprovals")
  reminders Reminder[] @relation("Reminders")
  reminders_created Reminder[] @relation("RemindersCreated")
  reminder_schedules ReminderSchedule[] @relation("ReminderSchedules")
  notification_queues NotificationQueue[] @relation("NotificationQueues")
  risk_assessments RiskAssessment[] @relation("RiskAssessments")
  saved_searches SavedSearch[] @relation("SavedSearches")
  webhooks Webhook[] @relation("Webhooks")
  integration_configs IntegrationConfig[] @relation("IntegrationConfigs")
  clauses Clause[] @relation("Clauses")

  @@index([company_id])
  @@index([email])
  @@index([is_super_admin])
  @@map("users")
}

model Contract {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id       String    @db.Uuid
  uploaded_by      String?   @db.Uuid
  category_id      String?   @db.Uuid
  name             String    @db.VarChar(500)
  contract_type    String?   @db.VarChar(100)
  file_type        String?   @db.VarChar(200)
  file_path        String?                    // đường dẫn tương đối từ UPLOAD_DIR
  file_size        Int?
  extracted_text   String?   @db.Text
  status           String?   @default("active") @db.VarChar(50)
  workflow_status  String?   @default("draft") @db.VarChar(50) // draft|pending_review|approved|signed|active|expired|terminated
  review_result    Json?
  metadata         Json?     @default("{}")
  content          String?   @db.Text
  notes            String?   @db.Text               // ghi chú nội bộ
  // Thông tin pháp lý
  effective_date   DateTime? @db.Timestamptz()
  expiry_date      DateTime? @db.Timestamptz()
  signed_date      DateTime? @db.Timestamptz()
  party_a_name     String?   @db.VarChar(500)
  party_b_name     String?   @db.VarChar(500)
  party_b_tax_code String?   @db.VarChar(50)
  contract_value   Decimal?  @db.Decimal(18, 2)
  currency         String?   @default("VND") @db.VarChar(10)
  created_at       DateTime? @default(now()) @db.Timestamptz()
  updated_at       DateTime? @default(now()) @db.Timestamptz()
  deleted_at       DateTime? @db.Timestamptz()

  company          Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  uploader         User?        @relation("ContractsUploadedBy", fields: [uploaded_by], references: [id], onDelete: SetNull)
  category         Category?    @relation(fields: [category_id], references: [id], onDelete: SetNull)
  tags             ContractTag[]
  linked_document  Document?    @relation("DocumentFromContract")

  @@index([company_id, created_at(sort: Desc)])
  @@index([company_id, expiry_date])
  @@map("contracts")
}

// ── Danh mục (tối đa 3 cấp, dùng chung cho contracts/documents/templates) ──
model Category {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id    String    @db.Uuid
  parent_id     String?   @db.Uuid
  resource_type String    @db.VarChar(50) // 'contract' | 'document' | 'template'
  name          String    @db.VarChar(200)
  description   String?
  color         String?   @db.VarChar(20)
  icon          String?   @db.VarChar(50)
  order_index   Int       @default(0)
  created_at    DateTime? @default(now()) @db.Timestamptz()

  company   Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  parent    Category?  @relation("CategoryChildren", fields: [parent_id], references: [id])
  children  Category[] @relation("CategoryChildren")
  contracts Contract[]
  documents Document[]

  @@index([company_id, resource_type])
  @@map("categories")
}

// ── Tags (dùng chung, gắn tag qua bảng junction) ─────────────────────────────
model Tag {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String    @db.Uuid
  name       String    @db.VarChar(100)
  color      String?   @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamptz()

  company       Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  contract_tags ContractTag[]
  document_tags DocumentTag[]

  @@unique([company_id, name])
  @@index([company_id])
  @@map("tags")
}

model ContractTag {
  contract_id String @db.Uuid
  tag_id      String @db.Uuid

  contract Contract @relation(fields: [contract_id], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([contract_id, tag_id])
  @@map("contract_tags")
}

model DocumentTag {
  document_id String @db.Uuid
  tag_id      String @db.Uuid

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([document_id, tag_id])
  @@map("document_tags")
}

model Document {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id         String    @db.Uuid
  uploaded_by        String?   @db.Uuid
  category_id        String?   @db.Uuid
  source_contract_id String?   @unique @db.Uuid  // liên kết nếu tài liệu được tạo từ upload hợp đồng
  name               String    @db.VarChar(500)
  file_path          String                    // đường dẫn tương đối từ UPLOAD_DIR
  file_size          Int?
  mime_type          String?   @db.VarChar(100)
  extracted_text     String?   @db.Text
  content            String?   @db.Text
  status             String?   @default("active") @db.VarChar(50)
  workflow_status    String?   @default("draft") @db.VarChar(50)
  analysis           Json?
  metadata           Json?     @default("{}")
  notes              String?
  created_at         DateTime? @default(now()) @db.Timestamptz()
  updated_at         DateTime? @default(now()) @db.Timestamptz()
  analyzed_at        DateTime? @db.Timestamptz()
  deleted_at         DateTime? @db.Timestamptz()

  company         Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  uploader        User?      @relation("DocumentsUploadedBy", fields: [uploaded_by], references: [id], onDelete: SetNull)
  category        Category?  @relation(fields: [category_id], references: [id], onDelete: SetNull)
  source_contract Contract?  @relation("DocumentFromContract", fields: [source_contract_id], references: [id], onDelete: SetNull)
  tags            DocumentTag[]

  @@index([company_id, created_at(sort: Desc)])
  @@index([company_id, workflow_status])
  @@index([source_contract_id])
  @@map("documents")
}

model ChatSession {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id      String      @db.Uuid
  user_id         String?     @db.Uuid
  title           String?
  agent_type      String?     @default("qa")
  status          String?     @default("active")
  metadata        Json?       @default("{}")
  message_count   Int?        @default(0)
  last_message_at DateTime?   @db.Timestamptz()
  created_at      DateTime?   @default(now()) @db.Timestamptz()

  company         Company     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user            User?       @relation("ChatSessionsByUser", fields: [user_id], references: [id], onDelete: SetNull)
  messages        Message[]

  @@index([company_id])
  @@index([user_id])
  @@map("chat_sessions")
}

model Message {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id    String      @db.Uuid
  company_id    String      @db.Uuid
  role          String
  content       String
  metadata      Json?       @default("{}")
  created_at    DateTime?   @default(now()) @db.Timestamptz()

  session       ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  company       Company     @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([company_id])
  @@map("messages")
}

model AuditLog {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id      String?   @db.Uuid
  actor_id        String    @db.Uuid
  action          String    @db.VarChar(50)
  resource_type   String    @db.VarChar(50)
  resource_id     String?   @db.Uuid
  changes         Json?     @default("{}")
  ip_address      String?   @db.VarChar(45)
  created_at      DateTime? @default(now()) @db.Timestamptz()

  actor           User      @relation("AuditLogByActor", fields: [actor_id], references: [id], onDelete: Cascade)
  company         Company?  @relation(fields: [company_id], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@index([actor_id])
  @@index([created_at])
  @@index([action])
  @@map("audit_logs")
}

// ── Draft Generated (Mẫu văn bản đã tạo từ templates) ─────────────────────────
model DraftGenerated {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id          String    @db.Uuid
  user_id             String    @db.Uuid
  template_id         String?   @db.VarChar(100)  // reference to template ID
  title               String?   @db.VarChar(500)  // Tên draft hoặc title
  content             String?   @db.Text          // HTML content từ TipTap editor
  research_data       Json?     @default("{}")    // Citations từ searchLegalEvidence()
  validation_result   Json?     @default("{}")    // {valid: bool, errors: [], warnings: [], suggestions: []}
  status              String    @default("draft") @db.VarChar(50)  // 'draft'|'review'|'approved'|'signed'
  version             Int       @default(1)        // Current version number
  review_status       String    @default("not_reviewed") @db.VarChar(50)
  review_started_at   DateTime? @db.Timestamptz()
  review_completed_at DateTime? @db.Timestamptz()
  has_legal_hold      Boolean   @default(false)
  overall_compliance_score Decimal? @db.Decimal(5, 2)
  is_signed           Boolean   @default(false)
  signed_at           DateTime? @db.Timestamptz()
  signed_by           String?   @db.Uuid
  created_at          DateTime? @default(now()) @db.Timestamptz()
  updated_at          DateTime? @default(now()) @db.Timestamptz()
  created_by          String?   @db.Uuid          // User who created
  updated_by          String?   @db.Uuid          // User who last updated

  company             Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  creator             User?              @relation("DraftCreatedBy", fields: [user_id], references: [id], onDelete: SetNull)
  versions            DraftVersion[]
  access_grants       DraftAccess[] @relation("DraftAccess")
  collaborators       DraftCollaborator[] @relation("DraftCollaborators")
  activity_logs       ActivityLog[] @relation("ActivityLogs")
  sharing_records     DraftSharing[] @relation("DraftSharing")
  review_sessions     ReviewSession[] @relation("ReviewSessions")
  review_comments     ReviewComment[] @relation("ReviewComments")
  risk_assessments    RiskAssessment[] @relation("RiskAssessments")
  approval_routes     ApprovalRoute[] @relation("ApprovalRoutes")
  audit_trails        AuditTrail[] @relation("AuditTrails")
  signatures          DigitalSignature[] @relation("DigitalSignatures")
  legal_holds         LegalHold[] @relation("LegalHolds")
  compliance_checks   ComplianceCheck[] @relation("ComplianceChecks")
  lifecycle_records   DocumentLifecycle[] @relation("DocumentLifecycle")
  search_indexes      SearchIndex[] @relation("SearchIndexes")
  clause_suggestions  ClauseSuggestion[] @relation("ClauseSuggestions")
  clause_conflicts    ClauseConflict[] @relation("ClauseConflicts")
  exports             ExportHistory[] @relation("ExportHistory")
  notifications       Notification[] @relation("NotificationsDraft")
  analytics           Analytic[] @relation("Analytics")
  reminders           Reminder[] @relation("RemindersDraft")
  signer              User?              @relation("DraftSignedBy", fields: [signed_by], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@index([user_id])
  @@index([template_id])
  @@index([status])
  @@index([review_status])
  @@index([has_legal_hold])
  @@index([is_signed])
  @@index([created_at(sort: Desc)])
  @@map("drafts_generated")
}

// ── Version Control for Drafts ──────────────────────────────────────────────
model DraftVersion {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draft_id    String    @db.Uuid
  version     Int
  content     String?   @db.Text          // HTML content at this version
  changed_by  String?   @db.Uuid          // User who made the change
  summary     String?   @db.VarChar(255)  // Change summary
  created_at  DateTime? @default(now()) @db.Timestamptz()

  draft      DraftGenerated @relation(fields: [draft_id], references: [id], onDelete: Cascade)
  updater    User?          @relation("DraftVersionChangedBy", fields: [changed_by], references: [id], onDelete: SetNull)

  @@unique([draft_id, version])
  @@index([draft_id])
  @@index([created_at])
  @@map("draft_versions")
}

model InvitationToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String    @db.VarChar(255)
  token       String    @unique @db.VarChar(64)
  role        UserRole  @default(member)
  expires_at  DateTime  @db.Timestamptz()
  created_by  String    @db.Uuid
  used_at     DateTime? @db.Timestamptz()
  used_by     String?   @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz()

  creator     User      @relation("InvitationCreateBy", fields: [created_by], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([expires_at])
  @@map("invitation_tokens")
}

model RefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique
  expires_at  DateTime  @db.Timestamptz()
  revoked_at  DateTime? @db.Timestamptz()
  created_at  DateTime? @default(now()) @db.Timestamptz()

  user        User      @relation("RefreshTokens", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}

// ============================================
// PHASE 3.1: AI-Powered Contract Review System
// ============================================

enum ReviewStatus {
  pending
  in_review
  completed
  cancelled
}

enum ReviewType {
  standard
  expedited
  compliance_check
}

enum ReviewAssignmentStatus {
  pending
  reviewed
  approved
  rejected
}

enum ReviewAssignmentRole {
  reviewer
  approver
  observer
}

model ReviewSession {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draft_id       String                @db.Uuid
  initiated_by   String                @db.Uuid
  status         ReviewStatus          @default(pending)
  start_date     DateTime?             @default(now()) @db.Timestamptz()
  end_date       DateTime?             @db.Timestamptz()
  due_date       DateTime?             @db.Timestamptz()
  review_type    ReviewType            @default(standard)
  notes          String?
  created_at     DateTime?             @default(now()) @db.Timestamptz()
  updated_at     DateTime?             @default(now()) @db.Timestamptz()

  draft          DraftGenerated    @relation("ReviewSessions", fields: [draft_id], references: [id], onDelete: Cascade)
  initiator      User                  @relation("ReviewSessionInitiatedBy", fields: [initiated_by], references: [id], onDelete: Cascade)
  assignments    ReviewAssignment[]
  comments       ReviewComment[]
  risk_assessments RiskAssessment[]

  @@index([draft_id])
  @@index([status])
  @@index([initiated_by])
  @@map("review_sessions")
}

model ReviewAssignment {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id   String                    @db.Uuid
  reviewer_id  String                    @db.Uuid
  role         ReviewAssignmentRole      @default(reviewer)
  status       ReviewAssignmentStatus    @default(pending)
  assigned_at  DateTime?                 @default(now()) @db.Timestamptz()
  reviewed_at  DateTime?                 @db.Timestamptz()
  notes        String?

  session      ReviewSession             @relation(fields: [session_id], references: [id], onDelete: Cascade)
  reviewer     User                      @relation("ReviewAssignments", fields: [reviewer_id], references: [id], onDelete: Cascade)

  @@unique([session_id, reviewer_id])
  @@index([session_id])
  @@index([reviewer_id])
  @@index([status])
  @@map("review_assignments")
}

enum CommentType {
  comment
  suggestion
  requirement
  note
}

enum CommentSeverity {
  critical
  high
  medium
  low
  info
}

model ReviewComment {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id        String          @db.Uuid
  draft_id          String          @db.Uuid
  commenter_id      String          @db.Uuid
  content           String          @db.Text
  clause_reference  String?         @db.VarChar(255)
  comment_type      CommentType     @default(comment)
  severity          CommentSeverity @default(info)
  resolved          Boolean         @default(false)
  resolved_by       String?         @db.Uuid
  resolved_at       DateTime?       @db.Timestamptz()
  parent_comment_id String?         @db.Uuid
  created_at        DateTime?       @default(now()) @db.Timestamptz()
  updated_at        DateTime?       @default(now()) @db.Timestamptz()

  session           ReviewSession   @relation(fields: [session_id], references: [id], onDelete: Cascade)
  draft             DraftGenerated  @relation("ReviewComments", fields: [draft_id], references: [id], onDelete: Cascade)
  commenter         User            @relation("ReviewComments", fields: [commenter_id], references: [id], onDelete: Cascade)
  resolver          User?           @relation("ReviewCommentResolvedBy", fields: [resolved_by], references: [id], onDelete: SetNull)
  parent            ReviewComment?  @relation("ReviewCommentReplies", fields: [parent_comment_id], references: [id], onDelete: Cascade)
  replies           ReviewComment[] @relation("ReviewCommentReplies")
  mentions          Mention[]

  @@index([session_id])
  @@index([draft_id])
  @@index([commenter_id])
  @@index([resolved])
  @@index([severity])
  @@map("review_comments")
}

model RiskAssessment {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draft_id             String    @db.Uuid
  session_id           String    @db.Uuid
  assessed_by          String?   @db.Uuid
  overall_risk_level   String    @db.VarChar(50) // critical, high, medium, low
  compliance_score     Decimal?  @db.Decimal(5, 2)
  assessment_date      DateTime? @default(now()) @db.Timestamptz()
  legal_risks          Json?     @default("[]")
  compliance_risks     Json?     @default("[]")
  operational_risks    Json?     @default("[]")
  financial_risks      Json?     @default("[]")
  recommendations      Json?     @default("[]")
  status               String    @default("completed") @db.VarChar(50)
  notes                String?
  created_at           DateTime? @default(now()) @db.Timestamptz()
  updated_at           DateTime? @default(now()) @db.Timestamptz()

