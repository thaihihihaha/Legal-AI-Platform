  config_data       Json      @default("{}")
  created_by        String?   @db.Uuid
  created_at        DateTime? @default(now()) @db.Timestamptz()
  updated_at        DateTime? @default(now()) @db.Timestamptz()
  last_used_at      DateTime? @db.Timestamptz()

  company           Company   @relation("IntegrationConfigs", fields: [company_id], references: [id], onDelete: Cascade)
  creator           User?     @relation("IntegrationConfigs", fields: [created_by], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@index([integration_type])
  @@index([is_enabled])
  @@map("integration_configs")
}

model ExportHistory {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draft_id        String    @db.Uuid
  exported_by     String    @db.Uuid
  export_type     String    @db.VarChar(50)
  export_format   String?   @db.VarChar(50)
  file_size_bytes Int?
  file_hash       String?   @db.VarChar(255)
  export_metadata Json?     @default("{}")
  created_at      DateTime? @default(now()) @db.Timestamptz()

  draft           DraftGenerated @relation("ExportHistory", fields: [draft_id], references: [id], onDelete: Cascade)
  exporter        User           @relation("ExportHistory", fields: [exported_by], references: [id], onDelete: Cascade)

  @@index([draft_id])
  @@index([exported_by])
  @@index([created_at])
  @@map("export_history")
}

model Webhook {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id      String    @db.Uuid
  webhook_url     String    @db.Text
  webhook_secret  String?   @db.VarChar(255)
  events          String[]  @default([])
  is_active       Boolean   @default(true)
  created_by      String?   @db.Uuid
  created_at      DateTime? @default(now()) @db.Timestamptz()
  updated_at      DateTime? @default(now()) @db.Timestamptz()
  last_triggered_at DateTime? @db.Timestamptz()
  failure_count   Int       @default(0)

  company         Company   @relation("Webhooks", fields: [company_id], references: [id], onDelete: Cascade)
  creator         User?     @relation("Webhooks", fields: [created_by], references: [id], onDelete: SetNull)
  deliveries      WebhookDelivery[]

  @@index([company_id])
  @@index([is_active])
  @@map("webhooks")
}

model WebhookDelivery {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhook_id        String    @db.Uuid
  event_type        String    @db.VarChar(100)
  payload           Json      @default("{}")
  response_status_code Int?
  response_body     String?
  delivery_status   String    @default("pending") @db.VarChar(50)
  retry_count       Int       @default(0)
  delivered_at      DateTime? @db.Timestamptz()
  created_at        DateTime? @default(now()) @db.Timestamptz()

  webhook           Webhook   @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@index([webhook_id])
  @@index([delivery_status])
  @@index([created_at])
  @@map("webhook_deliveries")
}

