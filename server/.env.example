# ============================================
# Cấu hình Môi trường Server Node.js (BACKEND)
# Hãy sao chép file này thành .env
# ============================================

# Cổng khởi chạy hệ thống máy chủ
APP_PORT=8080
CORS_ORIGIN=http://localhost:5173

# Thông tin Kết nối Cơ Sở Dữ Liệu
DATABASE_URL="postgresql://user:password@host:5432/db_name?schema=public"

# Bảo mật cấp cao
JWT_SECRET=your-jwt-secret-key

# Cấu hình Trí Tuệ Nhân Tạo (Azure OpenAI)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_TEMPERATURE=0.1
AI_AGENT_NAME="AI Legal Agent"

# Cấu hình kết nối Vector Storage (Pinecone)
PINECONE_API_KEY=pc-xxxxxxxxxxx
PINECONE_INDEX=legal-ai-master

# ── File Storage ───────────────────────────────────────────────────────────────
# URL gốc của ứng dụng — dùng để tạo URL file upload
# Local  : APP_BASE_URL=http://localhost:8080
# Product: APP_BASE_URL=https://tenmien.com
# Sau khi git pull trên server, chỉ cần set đúng cái này — không cần sửa code
APP_BASE_URL=http://localhost:8080
# Thư mục lưu file (mặc định: server/uploads/ — không cần đổi nếu dùng VPS thường)
# UPLOAD_DIR=/var/data/uploads

# ── Brave Search API (Tra cứu luật real-time) ──────────────────────────────
# Đăng ký tại: https://brave.com/search/api/
# Free tier: 2,000 request/tháng — đủ dùng cho môi trường test
# Khi có key này, hệ thống sẽ tìm kiếm trên vbpl.vn & thuvienphapluat.vn
# Nếu để trống, hệ thống fallback về DB hoặc local corpus
BRAVE_SEARCH_API_KEY=
