# Biến môi trường ở MỨC GỐC — dành cho nền tảng triển khai.
#
# VÌ SAO TỒN TẠI: bản quét tự-cấu-hình chỉ đọc thư mục được deploy (ở đây là gốc repo, vì Dockerfile
# gộp client + server thành một dịch vụ). Mọi khai báo thật nằm trong server/.env.example nên nó
# không thấy nhu cầu CSDL, không cấp Postgres, và server/src/config/env.js ném
# "Missing required environment variables: DATABASE_URL" ngay lúc khởi động.
#
# Cấu hình đầy đủ (Azure OpenAI, Pinecone, Brave Search…) vẫn xem server/.env.example.

# Chuỗi kết nối PostgreSQL. Nền tảng tự cấp CSDL và tự điền giá trị thật — giá trị dưới đây chỉ là
# mẫu để nhận diện đúng loại CSDL.
DATABASE_URL="postgresql://user:password@host:5432/db_name?schema=public"

# Khoá ký JWT. Đây là bí mật do CHÍNH app tạo và tự kiểm, không phải khoá của bên thứ ba, nên để
# nền tảng TỰ SINH là đúng. Bỏ trống thì app vẫn lên nhưng sinh khoá tạm mỗi lần khởi động, làm
# mọi phiên đăng nhập bị mất sau mỗi lần triển khai lại.
JWT_SECRET=""

# Tài khoản quản trị đầu tiên, tạo tự động khi CSDL chưa có người dùng nào.
# Bỏ trống SEED_ADMIN_PASSWORD thì app sinh mật khẩu ngẫu nhiên và IN RA LOG khởi động — đó là cách
# an toàn hơn, vì điền sẵn giá trị vào tệp này nghĩa là mọi bản triển khai từ mẫu dùng chung một
# mật khẩu quản trị nằm công khai trong git.
SEED_ADMIN_EMAIL="admin@legal-ai.local"
SEED_ADMIN_PASSWORD=""
SEED_COMPANY_NAME="Công ty mặc định"
SEED_COMPANY_SLUG="default"
